{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-destroy",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "phpstorm://*"
        },
        {
          "url": "idea://*"
        },
        {
          "url": "webstorm://*"
        },
        {
          "url": "vscode://*"
        },
        {
          "url": "cursor://*"
        }
      ]
    },
    "store:default",
    "dialog:default",
    "updater:default",
    "process:default",
    "notification:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "https://*:*"
        },
        {
          "url": "http://*"
        },
        {
          "url": "http://*:*"
        }
      ]
    }
  ]
}
