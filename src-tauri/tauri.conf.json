{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flux",
  "version": "0.25.1",
  "identifier": "com.emrebozkurt.flux",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Flux",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://updates.emreb.dev/updates/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM1NTgwOTlCQTk1NTBBQjUKUldTMUNsV3Btd2xZTlVPR0VadXVWcWxLMTVYZmU5dkNPU0pwbzg1dWNia0s0ampkaXpyN1FPdy8K"
    },
    "deep-link": {
      "desktop": {
        "schemes": ["flux"]
      }
    }
  }
}
