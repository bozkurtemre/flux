// flux.emreb.dev: the static pages in ./public, served by Cloudflare, with a small worker in
// front for what a page cannot do itself: /download goes to the version on offer, /api/latest
// says which that is, and /docs is the documentation, proxied from Mintlify. `make site`
// deploys it and binds the domain.
{
  "name": "flux-site",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "html_handling": "auto-trailing-slash", "not_found_handling": "404-page" },
  "routes": [{ "pattern": "flux.emreb.dev", "custom_domain": true }],
}
