#!/bin/sh
# Conventional Commits, so the history says what kind of change each commit is without
# opening it. Installed with `make hooks`; bypassed with `git commit --no-verify`.
set -e

subject=$(head -1 "$1")

# git's own wording, not ours to reshape
case "$subject" in
Merge\ * | Revert\ * | fixup!\ * | squash!\ *) exit 0 ;;
esac

if ! printf '%s' "$subject" | grep -qE '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: .+'; then
	echo "commit message must open with a Conventional Commits type:"
	echo "  feat: open a terminal in the project folder"
	echo "  fix(terminal): close the window when the prompt says to"
	echo "  feat!: a breaking change"
	echo
	echo "types: feat fix docs style refactor perf test build ci chore revert"
	echo "got: $subject"
	exit 1
fi
